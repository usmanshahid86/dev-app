# ---- Dev App configuration (copy to .env) ----
# Providers: fixture | jevlin
DEVAPP_SEARCH_PROVIDER=fixture
# Providers: fixture | claude-cli | anthropic-api
DEVAPP_AGENT_PROVIDER=fixture

# SQLite database location (relative to repo root)
DEVAPP_DB_PATH=data/devapp.sqlite
DEVAPP_PORT=4100

# Discovery search budget (max queries per discovery run)
DEVAPP_DISCOVERY_MAX_QUERIES=12
DEVAPP_DISCOVERY_MAX_RESULTS_PER_QUERY=8
DEVAPP_INVESTIGATION_MAX_QUERIES=8
DEVAPP_VALIDATION_MAX_QUERIES=5

# Jevlin (used when DEVAPP_SEARCH_PROVIDER=jevlin)
JEVLIN_BIN=/home/usman-dev/.local/bin/jevlin
JEVLIN_CONFIG=/home/usman-dev/.jevlin/jevlin.toml
JEVLIN_TIER=fast

# Claude Code CLI (used when DEVAPP_AGENT_PROVIDER=claude-cli)
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet

# Anthropic API (used when DEVAPP_AGENT_PROVIDER=anthropic-api)
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
