# ---- Dev App configuration (copy to .env) ----
# Providers: fixture | jevlin
DEVAPP_SEARCH_PROVIDER=fixture
# Providers: fixture | claude-cli | anthropic-api
DEVAPP_AGENT_PROVIDER=fixture

# SQLite database location (relative to repo root)
DEVAPP_DB_PATH=data/devapp.sqlite
DEVAPP_PORT=4100

# Discovery search budget (max queries per discovery run)
DEVAPP_DISCOVERY_MAX_QUERIES=12
DEVAPP_DISCOVERY_MAX_RESULTS_PER_QUERY=20
DEVAPP_INVESTIGATION_MAX_QUERIES=8
DEVAPP_VALIDATION_MAX_QUERIES=5

# Jevlin (used when DEVAPP_SEARCH_PROVIDER=jevlin)
JEVLIN_BIN=/home/usman-dev/.local/bin/jevlin
JEVLIN_CONFIG=/home/usman-dev/.jevlin/jevlin.toml
JEVLIN_TIER=fast

# Claude Code CLI (used when DEVAPP_AGENT_PROVIDER=claude-cli)
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet

# Anthropic API (used when DEVAPP_AGENT_PROVIDER=anthropic-api)
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- V0.1 evidence pipeline ----
# Evidence items per signal-extraction agent call
DEVAPP_DISCOVERY_EVIDENCE_BATCH_SIZE=25
# Full-page fetch budgets per run kind (discovery never fetches)
DEVAPP_COMPARISON_MAX_PAGE_FETCHES=4
DEVAPP_INVESTIGATION_MAX_PAGE_FETCHES=8
DEVAPP_VALIDATION_MAX_PAGE_FETCHES=3
# Page fetcher: http (default in real mode) | fixture (default in demo mode)
# DEVAPP_PAGE_FETCHER=http
# Chars of fetched page text per evidence packet handed to the agent
DEVAPP_PACKET_MAX_CHARS=3000
# Largest max_results sent to the Jevlin router (20 = largest value honoured on the fast tier)
JEVLIN_MAX_RESULTS_LIMIT=20

# ---- V0.1.1 retrieval status ----
# Total wall-clock a run may spend waiting on retryable search failures (honours retry_after_ms)
DEVAPP_SEARCH_RETRY_BUDGET_MS=90000
# Retries per query on retryable failures (0 disables)
DEVAPP_SEARCH_MAX_RETRIES_PER_QUERY=1
# Wait used when a retryable failure carries no retry_after_ms
DEVAPP_SEARCH_DEFAULT_RETRY_WAIT_MS=5000
